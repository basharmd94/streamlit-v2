# WhatsApp Cloud API webhook receiver — copy this to .env and fill in real
# values. .env is gitignored (repo's *.env rule) — never commit real secrets.

# Any string you choose — must match exactly what you enter in
# Meta App Dashboard > WhatsApp > Configuration > Webhooks > Verify Token.
WHATSAPP_VERIFY_TOKEN=choose-a-random-string

# Meta App Dashboard > App Settings > Basic > App Secret (click "Show").
# Used to verify the X-Hub-Signature-256 header on every incoming POST.
META_APP_SECRET=

# Separate Postgres database — isolated from the main app's `da` database.
# Create it yourself first (see README.md), then fill these in.
WEBHOOK_DB_HOST=localhost
WEBHOOK_DB_PORT=5432
WEBHOOK_DB_NAME=whatsapp_webhooks
WEBHOOK_DB_USER=postgres
WEBHOOK_DB_PASSWORD=postgres

# WhatsFly's webhook delivery has no documented signing/secret mechanism of
# its own, so /webhook/whatsfly/{token} trusts a random token embedded in
# the URL path instead. Generate one (e.g. `python3 -c "import secrets;
# print(secrets.token_urlsafe(32))"`) and paste the FULL resulting URL
# (https://<host>/webhook/whatsfly/<this token>) into WhatsFly's own
# Settings > Webhook > URL field — not a bare /webhook/whatsfly.
WHATSFLY_WEBHOOK_TOKEN=
